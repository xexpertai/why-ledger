# Zetaris: unset = STUB sqlite; ZETARIS_LIVE=1 + API key = REST; ZETARIS_LIVE=jdbc = JDBC
ZETARIS_LIVE=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# JDBC (local platform; password read from ZETARIS_PLATFORM_ENV or ZETARIS_JDBC_PASSWORD)
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_USER=admin@zetaris.com
ZETARIS_PLATFORM_ENV=~/zetaris/zetaris-platform/.env

# Meterless Nightshift Runtime (primary when METERLESS_RUNTIME_TOKEN is set)
# WSL: use Windows host IP + portproxy, e.g. http://172.22.48.1:18088/v1 (not 127.0.0.1)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# nvidia/nemotron-3.5-lightning-30b-a3b works on this account; super-120b → 404; llama-3.3-nemotron-super-49b → 410
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# LLM routing: nvidia | meterless | stub (overrides auto priority)
LLM_ROUTE=

# Live investigator: planned (code evidence + one draft call) | loop (tool steps)
LIVE_AGENT_MODE=planned

# NVIDIA direct (fallback when no Meterless token)
NVIDIA_API_KEY=
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Replay / UI mode
WHYLEDGER_MODE=
WHYLEDGER_REPLAY=
